# ==============================================================================
# KINETIQ Environment Configuration
# ==============================================================================

# Supabase (Postgres, Auth, Storage, RLS, Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cashfree Payments (Server-created orders, JS SDK checkout, webhooks)
CASHFREE_APP_ID=TEST_APP_ID_HERE
CASHFREE_SECRET_KEY=TEST_SECRET_KEY_HERE_SERVER_ONLY
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# Transactional Emails (Resend API)
RESEND_API_KEY=re_your_resend_api_key_here

# First-Party Analytics Sampling (1.0 = 100% of events)
NEXT_PUBLIC_ANALYTICS_SAMPLE_RATE=1.0
